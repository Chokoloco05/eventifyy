{
  "name": "eventifyy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:native:web": "turbo -F native web",
    "native:start": "turbo -F native start",
    "native:android": "turbo -F native android",
    "native:ios": "turbo -F native ios",
    "dev:web": "turbo -F web dev",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "docker:down": "docker compose down",
    "auth:clear-sessions": "node packages/db/scripts/clear-sessions.mjs",
    "db:push": "turbo -F @eventifyy/db db:push",
    "db:studio": "turbo -F @eventifyy/db db:studio",
    "db:generate": "turbo -F @eventifyy/db db:generate",
    "db:migrate": "turbo -F @eventifyy/db db:migrate",
    "db:start": "turbo -F @eventifyy/db db:start",
    "db:watch": "turbo -F @eventifyy/db db:watch",
    "db:stop": "turbo -F @eventifyy/db db:stop",
    "db:down": "turbo -F @eventifyy/db db:down"
  },
  "dependencies": {
    "@eventifyy/env": "*",
    "dotenv": "^17.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eventifyy/config": "*",
    "@types/node": "^22.13.14",
    "turbo": "^2.8.12",
    "typescript": "5.9.2"
  },
  "packageManager": "npm@11.6.2"
}
